# Salin menjadi .env lalu sesuaikan. Lihat DEPLOY.md.

# Database SQLite (path relatif terhadap folder prisma/)
DATABASE_URL="file:./dev.db"

# WAJIB: string acak minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mengganti nilai ini membuat semua pengguna harus login ulang.
SESSION_SECRET=""

# Cookie login hanya lewat HTTPS (default: true saat produksi).
# Untuk server lab yang diakses via http://IP-lokal (tanpa HTTPS), isi false.
COOKIE_SECURE=false

# Opsional: folder foto peserta & logo (default: ./storage). Sebaiknya di luar folder aplikasi.
# STORAGE_DIR="D:/cat-data/storage"
